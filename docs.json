{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cominty Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/logo/cominty-logo.png",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "guides/agents"
            ]
          },
          {
            "group": "Capabilities",
            "pages": [
              "guides/capabilities",
              "guides/capabilities-use-cases",
              "guides/capabilities-troubleshooting"
            ]
          },
          {
            "group": "Build with code",
            "pages": [
              "guides/custom-agents",
              "guides/skills",
              "guides/sources"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "guides/memory-namespaces",
              "guides/max-steps",
              "guides/static-ip"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "mcp/overview",
              "mcp/connector-instructions",
              "mcp/oauth-callback"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "mcp/integrations/bigquery",
              "mcp/integrations/hubspot"
            ]
          }
        ]
      },
      {
        "tab": "Python SDK",
        "groups": [
          {
            "group": "Python SDK",
            "pages": [
              "sdk/overview",
              "sdk/quickstart",
              "sdk/reference"
            ]
          }
        ]
      },
      {
        "tab": "JavaScript SDK",
        "groups": [
          {
            "group": "JavaScript SDK",
            "pages": [
              "js-sdk/overview",
              "js-sdk/quickstart",
              "js-sdk/reference"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "openapi": "/openapi.json",
            "pages": [
              "api-reference",
              {
                "group": "Threads",
                "icon": "messages-square",
                "expanded": true,
                "pages": [
                  "POST /chat",
                  "POST /chat/{thread_id}",
                  "GET /chat",
                  "GET /chat/{thread_id}",
                  "PUT /chat/{thread_id}",
                  "DELETE /chat/{thread_id}"
                ]
              },
              {
                "group": "Messages",
                "icon": "message-square",
                "expanded": true,
                "pages": [
                  "GET /chat/messages/{message_id}/stream",
                  "POST /chat/messages/{message_id}/cancel",
                  "GET /chat/messages/{message_id}/export"
                ]
              },
              {
                "group": "Files",
                "icon": "paperclip",
                "expanded": true,
                "pages": [
                  "GET /chat/files/upload",
                  "POST /chat/files",
                  "GET /chat/files/{file_pid}"
                ]
              },
              {
                "group": "Memory",
                "icon": "database",
                "expanded": true,
                "pages": [
                  "GET /memory",
                  "GET /memory/namespaces",
                  "POST /memory",
                  "GET /memory/file",
                  "PUT /memory/file",
                  "DELETE /memory/file"
                ]
              },
              {
                "group": "MCP",
                "icon": "plug",
                "expanded": true,
                "pages": [
                  "GET /mcp/manifest"
                ]
              },
              {
                "group": "Agents",
                "icon": "bot",
                "expanded": true,
                "pages": [
                  "GET /agents",
                  "GET /agents/models",
                  "GET /agents/{agent_pid}",
                  "POST /agents",
                  "PUT /agents/{agent_pid}",
                  "PUT /agents/{agent_pid}/models",
                  "DELETE /agents/{agent_pid}"
                ]
              },
              {
                "group": "Skills",
                "icon": "sparkles",
                "expanded": true,
                "pages": [
                  "GET /skills",
                  "POST /skills",
                  "PUT /skills/{skill_pid}",
                  "POST /skills/{skill_pid}/versions",
                  "DELETE /skills/{skill_pid}"
                ]
              },
              {
                "group": "Sources",
                "icon": "folder-search",
                "expanded": true,
                "pages": [
                  "GET /dc/sources",
                  "POST /dc/sources",
                  "PUT /dc/sources/{source_pid}",
                  "PUT /dc/sources/{source_pid}/status",
                  "POST /drives",
                  "GET /drives/{drive_pid}",
                  "GET /drives/{drive_pid}/upload",
                  "POST /drives/upload",
                  "GET /files/{file_pid}",
                  "DELETE /files/{file_pid}"
                ]
              },
              {
                "group": "Documents",
                "icon": "file-text",
                "expanded": true,
                "pages": [
                  "GET /documents"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/sdk/memory",
      "destination": "/guides/memory-namespaces"
    },
    {
      "source": "/sdk/max-steps",
      "destination": "/guides/max-steps"
    }
  ],
  "logo": {
    "light": "/logo/cominty-docs-light.svg",
    "dark": "/logo/cominty-docs-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@cominty.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Go to Cominty",
      "href": "https://platform.cominty.ai/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/cominty"
    }
  }
}

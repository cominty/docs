{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cominty Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/logo/cominty-logo.png",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          }
        ]
      },
      {
        "tab": "Python SDK",
        "groups": [
          {
            "group": "Python SDK",
            "pages": [
              "sdk/overview",
              "sdk/quickstart",
              "sdk/memory",
              "sdk/max-steps",
              "sdk/reference"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "openapi": "/openapi.json",
            "pages": [
              "api-reference",
              {
                "group": "Threads",
                "icon": "messages-square",
                "expanded": true,
                "pages": [
                  "POST /chat",
                  "POST /chat/{thread_id}",
                  "GET /chat",
                  "GET /chat/{thread_id}",
                  "PUT /chat/{thread_id}",
                  "DELETE /chat/{thread_id}"
                ]
              },
              {
                "group": "Messages",
                "icon": "message-square",
                "expanded": true,
                "pages": [
                  "GET /chat/messages/{message_id}/stream",
                  "POST /chat/messages/{message_id}/cancel",
                  "GET /chat/messages/{message_id}/export"
                ]
              },
              {
                "group": "Files",
                "icon": "paperclip",
                "expanded": true,
                "pages": [
                  "GET /chat/files/upload",
                  "POST /chat/files",
                  "GET /chat/files/{file_pid}"
                ]
              },
              {
                "group": "Memory",
                "icon": "database",
                "expanded": true,
                "pages": [
                  "GET /memory",
                  "GET /memory/namespaces",
                  "POST /memory",
                  "GET /memory/file",
                  "PUT /memory/file",
                  "DELETE /memory/file"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/cominty-docs-light.svg",
    "dark": "/logo/cominty-docs-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@cominty.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Go to Cominty",
      "href": "https://platform.cominty.ai/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/cominty"
    }
  }
}

{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cominty Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/logo/cominty-logo.png",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          }
        ]
      },
      {
        "tab": "Python SDK",
        "groups": [
          {
            "group": "Python SDK",
            "pages": [
              "sdk/overview",
              "sdk/quickstart",
              "sdk/reference"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "openapi": "/openapi.json",
            "pages": [
              "api-reference",
              "POST /chat",
              "POST /chat/{thread_id}",
              "GET /chat/messages/{message_id}/stream",
              "GET /chat",
              "GET /chat/{thread_id}",
              "PUT /chat/{thread_id}",
              "DELETE /chat/{thread_id}",
              "GET /memory",
              "POST /memory",
              "GET /memory/file",
              "PUT /memory/file",
              "DELETE /memory/file"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/cominty-docs-light.svg",
    "dark": "/logo/cominty-docs-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@cominty.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Go to Cominty",
      "href": "https://app.cominty.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/cominty"
    }
  }
}
